#!/bin/sh /etc/rc.common
# OpenWrt procd service for srun. Install:
#   cp srun /usr/bin/srun && chmod +x /usr/bin/srun
#   mkdir -p /etc/srun && vi /etc/srun/config.json   (or: srun user add NAME)
#   cp srun.init /etc/init.d/srun && chmod +x /etc/init.d/srun
#   /etc/init.d/srun enable && /etc/init.d/srun start
# Logs: logread -e srun

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/srun
CONFIG=/etc/srun/config.json

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c "$CONFIG" daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# Optional: drop the session when the service stops.
	# "$PROG" -c "$CONFIG" logout
	:
}
