<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd agent for srun. Install:
       cp srun /usr/local/bin/srun
       srun user add NAME
       cp com.srun.daemon.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.srun.daemon.plist
     Logs: /tmp/srun.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.srun.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/srun</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/srun.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/srun.log</string>
</dict>
</plist>
